    [
      "# Function to calculate f(n) = g(n) + h(n)"
    ],
    [
      "def get_fn(citystr):"
    ],
    [
      "cities = citystr.split(\",\")"
    ],
    [
      "gn = 0"
    ],
    [
      "for ctr in range(0, len(cities) - 1):"
    ],
    [
      "gn += dict_gn[cities[ctr]][cities[ctr + 1]]"
    ],
    [
      "hn = dict_hn[cities[-1]] # heuristic from last city"
    ],
    [
      "return hn + gn"
    ]
  ]
}